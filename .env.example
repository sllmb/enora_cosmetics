# Copier en .env.local (jamais versionné) et renseigner.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro international sans + ni espaces, ex. 221771234567. Vide = bouton WhatsApp masqué.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_. À renseigner aussi chez l'hébergeur.
SUPABASE_SERVICE_ROLE_KEY=
